# Which model to run. Part 3 = change this line. One file per option in config/:
#   kimi       Kimi K2 via OpenRouter        (recommended — open weights, delegates reliably)
#   llama33    Llama-3.3-70B via OpenRouter  (open weights; see performance notes on providers)
#   openrouter Qwen3-32B via OpenRouter       (open weights; a thinking model, so slower)
#   llama      Llama-3.1-8B via OpenRouter    (open weights; fails at delegation — kept as a data point)
#   ollama     local, self-hosted, no account needed
#   openai     gpt-5-mini                     (hosted baseline)
#   fast       Qwen3.7-Flash                  (fastest, but Alibaba-only: NOT self-hostable)
MODEL=kimi

OPENAI_API_KEY=
TRADE_GOV_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=ollama          # any value; Ollama ignores it
