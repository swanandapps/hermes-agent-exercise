# The agent tier: the Hermes runtime plus this project's MCP tool server.
#
# Why our tools live in HERE and not in the web container: the config registers them
# with stdio transport, meaning Hermes launches `python -m trade_tools.trade_mcp.server` as a
# child process and talks to it over a pipe. A pipe cannot cross a container boundary,
# so the tools must sit beside the runtime that spawns them. (MCP also has an HTTP
# transport, which would let them be their own service — see README.)
#
# Built on plain python rather than the official nousresearch/hermes-agent image: that
# image runs an s6-overlay supervision tree with its own init hooks, which is more to
# reason about than this needs. hermes-agent is on PyPI, so a normal pip install gives
# a smaller, readable image we can explain line by line.
FROM python:3.11-slim

# git: Hermes shells out to it for some skill/plugin operations.
# curl: the healthcheck in docker-compose.yml.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl \
 && rm -rf /var/lib/apt/lists/*

# Hermes, plus the two libraries our MCP server itself imports.
#
# aiohttp is what serves the gateway's HTTP API, and a plain `pip install hermes-agent`
# does NOT bring it: it only arrives via the messaging/slack/matrix extras, none of which
# we want. Without it the gateway boots but logs "API Server: aiohttp not installed" and
# serves nothing — so the container looks alive while being useless. Version matches the
# pin in Hermes's own pyproject (3.14.1, pinned for CVE fixes).
# `mcp` is what trade_tools/trade_mcp/server.py imports (FastMCP). Hermes ships its own MCP
# *client*, but our server is a separate process that needs the library in its own right —
# and a container inherits nothing from the developer's machine, where it happened to be
# in .venv already. Without it the gateway starts fine and simply has no tools:
#   "Tool 'screen_party' does not exist. Available tools: delegate_task, memory, ..."
#
# Pinned exactly, not ">=1.0": mcp 2.0 removed mcp.server.fastmcp entirely (FastMCP became
# mcp.server.mcpserver), so an unpinned install silently picked up a breaking major and the
# tool server would not import. 1.28.1 is the version this project is developed against.
RUN pip install --no-cache-dir \
      "hermes-agent==0.19.0" \
      "aiohttp==3.14.1" \
      "mcp==1.28.1" \
      "httpx>=0.27" \
      "pyyaml>=6.0"

WORKDIR /srv
COPY trade_tools/ ./trade_tools/
COPY agents/ ./agents/
COPY config/ ./config/
COPY run.py ./
COPY docker/gateway-entrypoint.sh /usr/local/bin/gateway-entrypoint.sh
RUN chmod +x /usr/local/bin/gateway-entrypoint.sh

# HERMES_HOME makes this directory *the* profile. Inside a container there are no other
# profiles to stay isolated from, so the named-profile dance we do locally is unnecessary.
# Mounted as a volume in compose so memory and session history survive a restart.
ENV HERMES_HOME=/data/hermes \
    PYTHONPATH=/srv \
    PYTHONUNBUFFERED=1

EXPOSE 8642
ENTRYPOINT ["/usr/local/bin/gateway-entrypoint.sh"]
